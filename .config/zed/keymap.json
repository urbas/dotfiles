// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "ctrl-!": "editor::ToggleFocus",
      "ctrl-alt-z": "terminal_panel::Toggle",
    },
    "unbind": {
      "f4": "debugger::Start"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-1": ["workspace::ActivatePane", 0],
      "ctrl-2": ["workspace::ActivatePane", 1],
      "ctrl-3": ["workspace::ActivatePane", 2],
      "ctrl-4": ["workspace::ActivatePane", 3],
      "ctrl-`": "workspace::ToggleLeftDock",
      "ctrl-alt-[": [
        "workspace::DecreaseActiveDockSize",
        {
          "px": 0,
        },
      ],
      "ctrl-alt-]": [
        "workspace::IncreaseActiveDockSize",
        {
          "px": 0,
        },
      ],
      "ctrl-alt-shift-pagedown": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "right",
        },
      ],
      "ctrl-alt-shift-pageup": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "left",
        },
      ],
    },
    "unbind": {
      "f5": "debugger::Rerun",
      "ctrl-t": "project_symbols::Toggle",
      "ctrl-s": "workspace::Save",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-e ctrl-s": "editor::SortLinesCaseInsensitive",
      "ctrl-s": "workspace::Save",
    },
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "enter": "project_panel::Rename"
    },
  },
  {
    "context": "(ProjectPanel && not_editing)",
    "bindings": {
      "enter": "project_panel::Open",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-1": ["terminal::SendKeystroke", "alt-1"],
      "alt-2": ["terminal::SendKeystroke", "alt-2"],
      "alt-3": ["terminal::SendKeystroke", "alt-3"],
      "alt-4": ["terminal::SendKeystroke", "alt-4"],
      "alt-5": ["terminal::SendKeystroke", "alt-5"],
      "alt-6": ["terminal::SendKeystroke", "alt-6"],
      "alt-7": ["terminal::SendKeystroke", "alt-7"],
      "alt-8": ["terminal::SendKeystroke", "alt-8"],
      "alt-9": ["terminal::SendKeystroke", "alt-9"],
    },
  },
]
